# Cyber Lanlan deployment environment file (placeholder values only).
#
# Copy this file to lanlan.env and edit it. Never commit the real file: it is
# the only place a deployment holds deployment-specific settings, and it must
# stay out of the repository. Examples below are obviously fake.
#
#   cp deploy/lanlan.env.example deploy/lanlan.env
#
# Required by the compose file:
#   LANLAN_DOMAIN   the public host name Caddy requests a certificate for.
#
# Optional; the service falls back to its built-in defaults when unset:
#   LANLAN_DB                  database path inside the container
#                              (compose sets /data/lanlan.sqlite3)
#   LANLAN_TIMEZONE            family timezone, default Asia/Shanghai
#   LANLAN_FAMILY_NAME         family display name, default "Lanlan family"
#   LANLAN_SESSION_DAYS        session lifetime, default 30
#   LANLAN_PBKDF2_ITERATIONS   password cost, default 210000
#   LANLAN_ALLOW_INSECURE      only for a deliberately intercepted deployment

LANLAN_DOMAIN=lanlan.example.invalid
LANLAN_TIMEZONE=Asia/Shanghai
LANLAN_FAMILY_NAME=Example family
LANLAN_SESSION_DAYS=30
LANLAN_PBKDF2_ITERATIONS=210000
